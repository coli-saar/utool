%start Input
%title "Utool Hole Semantics"
%comment "Computational-semantics hole-semantics term syntax"
%grammar_type 'll(k)'
%line_comment '%'

%%

Input: Term;

Term
    : 'and' '(' Term ',' Term ')'
    | 'some' '(' Variable ',' Term ')'
    | 'hole' '(' Variable ')'
    | 'label' '(' Variable ')'
    | 'leq' '(' Variable ',' Variable ')'
    | 'pred1' '(' Variable ',' Atom ',' Value ')'
    | 'pred2' '(' Variable ',' Atom ',' Value ',' Value ')'
    | LogicalConstant '(' Variable ',' Value { ',' Value } ')'
    ;

LogicalConstant
    : 'and' | 'or' | 'imp' | 'not' | 'all' | 'some' | 'que' | 'eq'
    ;

Value: Variable | Atom;

Variable: /[A-Z_][a-zA-Z0-9_'&]*/;

Atom
    : /'(\\.|[^'])*'/
    | /[a-z][a-zA-Z0-9_'&]*/
    ;

